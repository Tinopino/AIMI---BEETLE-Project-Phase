# Copy to paths.env, adapt the paths, then run:
#   source paths.env
#
# These defaults match the original course-cluster layout. Replace the group
# root, data root, validation-mask root, validation CSV directory, and virtual
# environment as needed on another system.

export AIMI_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export AIMI_GROUP_ROOT="/vol/csedu-nobackup/course/IMC037_aimi/group14"
export BEETLE_DATA_ROOT="${AIMI_GROUP_ROOT}/aalina"

export nnUNet_raw="${AIMI_GROUP_ROOT}/nnunet/tijn/pathology/nnUNet_raw"
export nnUNet_preprocessed="${AIMI_GROUP_ROOT}/nnunet/tijn/pathology/nnUNet_preprocessed"
export nnUNet_results="${AIMI_GROUP_ROOT}/nnunet/tijn/pathology/nnUNet_results"

export BEETLE_EXTERNAL_ROIS="${BEETLE_DATA_ROOT}/images/evaluation/rois"
export BEETLE_VALIDATION_MASK_ROOT="${BEETLE_DATA_ROOT}/annotations/masks"
export BEETLE_VALIDATION_CSV_DIR="${AIMI_REPO_ROOT}/outputs/validation_inputs"

export BEETLE_OUTPUT_ROOT="${AIMI_REPO_ROOT}/outputs"
export BEETLE_VISUAL_ROOT="${BEETLE_OUTPUT_ROOT}/visuals"
export BEETLE_EXTERNAL_PREDICTION_ROOT="${BEETLE_OUTPUT_ROOT}/external_predictions"
export BEETLE_SUBMISSION_ROOT="${BEETLE_OUTPUT_ROOT}/submissions"
export BEETLE_CV_SUMMARY_ROOT="${BEETLE_OUTPUT_ROOT}/cv_summaries/cutmixema1000_context1024"

export BEETLE_VENV="/scratch/${USER}/virtual_environments/AIMI-BEETLE"
